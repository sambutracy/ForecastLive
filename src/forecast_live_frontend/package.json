{
  "name": "forecast-live-frontend",
  "version": "1.0.0",
  "description": "Forecast Live - F1 Prediction dApp Frontend",
  "main": "src/index.tsx",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development --open",
    "test": "jest",
    "dfx:start": "node ./scripts/run-dfx.js start --background --clean",
    "dfx:deploy": "node ./scripts/run-dfx.js deploy",
    "deploy:auth": "node ./scripts/run-dfx.js deploy auth_service --no-wallet",
    "deploy:backend": "node ./scripts/run-dfx.js deploy forecast_live_backend --no-wallet",
    "deploy:all": "npm run dfx:start && npm run deploy:auth && npm run deploy:backend",
    "typecheck": "tsc --noEmit",
    "generate-types": "dfx generate"
  },
  "dependencies": {
    "@dfinity/agent": "^2.4.1",
    "@dfinity/auth-client": "^2.4.1",
    "@dfinity/candid": "^2.4.1",
    "@dfinity/identity": "^2.4.1",
    "@dfinity/ledger-icp": "^2.0.0",
    "@dfinity/principal": "^2.4.1",
    "@dfinity/utils": "^2.4.1",
    "@nfid/embed": "^0.10.3",
    "@nfid/identitykit": "^1.0.14",
    "axios": "1.10.0",
    "chart.js": "4.4.0",
    "framer-motion": "^12.23.12",
    "react": "18.3.1",
    "react-chartjs-2": "5.2.0",
    "react-dom": "18.3.1",
    "react-dropzone": "14.2.3",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@babel/core": "7.22.0",
    "@babel/preset-env": "7.22.0",
    "@babel/preset-react": "7.22.0",
    "@babel/preset-typescript": "^7.23.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "10.4.14",
    "babel-loader": "9.1.0",
    "css-loader": "6.8.0",
    "html-webpack-plugin": "5.5.0",
    "postcss": "8.4.24",
    "postcss-loader": "7.3.0",
    "style-loader": "3.3.0",
    "tailwindcss": "3.3.0",
    "typescript": "^5.9.2",
    "webpack": "5.88.0",
    "webpack-cli": "5.1.0",
    "webpack-dev-server": "5.2.1"
  },
  "keywords": [
    "icp",
    "blockchain",
    "formula1",
    "prediction",
    "dapp"
  ],
  "author": "Forecast Live Team",
  "license": "MIT"
}
