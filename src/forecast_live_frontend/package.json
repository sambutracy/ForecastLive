{
  "name": "forecast-live-frontend",
  "version": "1.0.0",
  "description": "Forecast Live - F1 Prediction dApp Frontend",
  "main": "src/index.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:local": "node -e \"process.env.NODE_ENV='development'; require('./node_modules/.bin/webpack')\" --mode development",
    "build:ic": "node -e \"process.env.NODE_ENV='production'; require('./node_modules/.bin/webpack')\" --mode production",
    "dev": "webpack serve --mode development --open",
    "dev:local": "node -e \"process.env.DFX_NETWORK='local'\" && npm run prepare-env && npm run dev",
    "dev:ic": "node -e \"process.env.DFX_NETWORK='ic'\" && npm run prepare-env && npm run dev",
    "prepare-env": "node scripts/prepare-env.js",
    "test": "jest"
  },
  "dependencies": {
    "@dfinity/agent": "0.18.1",
    "@dfinity/auth-client": "0.18.1",
    "@dfinity/candid": "0.18.1",
    "@dfinity/identity": "0.18.1",
    "@dfinity/principal": "0.18.1",
    "@nfid/embed": "^0.10.3",
    "axios": "1.10.0",
    "chart.js": "4.4.0",
    "react": "18.2.0",
    "react-chartjs-2": "5.2.0",
    "react-dom": "18.2.0",
    "react-dropzone": "14.2.3",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@babel/core": "7.22.0",
    "@babel/preset-env": "7.22.0",
    "@babel/preset-react": "7.22.0",
    "autoprefixer": "10.4.14",
    "babel-loader": "9.1.0",
    "css-loader": "6.8.0",
    "html-webpack-plugin": "5.5.0",
    "postcss": "8.4.24",
    "postcss-loader": "7.3.0",
    "style-loader": "3.3.0",
    "tailwindcss": "3.3.0",
    "webpack": "5.88.0",
    "webpack-cli": "5.1.0",
    "webpack-dev-server": "5.2.1"
  },
  "keywords": [
    "icp",
    "blockchain",
    "formula1",
    "prediction",
    "dapp"
  ],
  "author": "Forecast Live Team",
  "license": "MIT"
}
