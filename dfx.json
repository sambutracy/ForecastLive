{
  "version": 1,
  "canisters": {
    "internet_identity": {
      "type": "custom",
      "candid": "https://github.com/dfinity/internet-identity/releases/latest/download/internet_identity.did",
      "wasm": "https://github.com/dfinity/internet-identity/releases/latest/download/internet_identity_dev.wasm.gz",
      "shrink": false,
      "remote": {
        "candid": "https://github.com/dfinity/internet-identity/releases/latest/download/internet_identity.did",
        "id": {
          "ic": "rdmx6-jaaaa-aaaaa-aaadq-cai"
        }
      }
    },
    "auth_service": {
      "main": "src/forecast_live_backend/AuthService.mo",
      "type": "motoko",
      "declarations": {
        "output": "src/declarations"
      }
    },
    "users_service": {
      "main": "src/forecast_live_backend/Users.mo",
      "type": "motoko",
      "declarations": {
        "output": "src/declarations"
      }
    },
    "forecast_live_backend": {
      "main": "src/forecast_live_backend/main.mo",
      "type": "motoko",
      "dependencies": [
        "auth_service",
        "users_service"
      ],
      "declarations": {
        "output": "src/declarations"
      }
    },
    "prediction_service": {
      "main": "src/forecast_live_backend/PredictionService.mo",
      "type": "motoko",
      "dependencies": [
        "f1_data_service",
        "ai_prediction_service",
        "users_service"
      ]
    },
    "f1_data_service": {
      "main": "src/forecast_live_backend/F1DataService.mo",
      "type": "motoko"
    },
    "ai_prediction_service": {
      "main": "src/forecast_live_backend/AIPredictionService.mo",
      "type": "motoko"
    },
    "forecast_live_frontend": {
      "dependencies": [
        "forecast_live_backend",
        "prediction_service",
        "f1_data_service",
        "auth_service",
        "users_service",
        "internet_identity"
      ],
      "frontend": {
        "entrypoint": "src/forecast_live_frontend/src/index.html"
      },
      "source": [
        "src/forecast_live_frontend/assets",
        "src/forecast_live_frontend/dist/"
      ],
      "type": "assets"
    }
  },
  "defaults": {
    "build": {
      "args": "",
      "packtool": ""
    }
  },
  "output_env_file": ".env"
}
